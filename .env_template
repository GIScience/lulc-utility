OHSOME_BASE_URL=

# Model registry
MLFLOW_TRACKING_URI=  # 'sqlite:///mlruns.db' for local file storage, then skip the other MLFLOW variables
MLFLOW_WORKSPACE=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Required for the SentinelHub image store
SENTINELHUB_API_ID=
SENTINELHUB_API_SECRET=

# Required for the MinIO image store
MINIO_HOST=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=

# For serving the FastAPI for inference, defaults to 1
LULC_UVICORN_WORKERS=

# Optional
LOG_LEVEL=
